PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jewelry_store
DB_USER=root
DB_PASSWORD=
# Generate 32 random bytes and encode as Base64. Keep this outside source control.
AUTH_ENCRYPTION_KEY=
# Optional persistent directory for uploaded product photos (production volume path).
UPLOADS_DIR=
# Set only when running behind a known trusted reverse proxy.
TRUST_PROXY_HOPS=

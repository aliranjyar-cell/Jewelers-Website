# ------------------------------------------------------------------
# Jewelry Store — Server environment (.env)
# Copy this file to .env and fill in production values before launch.
# Never commit .env to source control.
# ------------------------------------------------------------------

# Port the Node.js API listens on (host-provided in production).
PORT=4000

# Set to `production` when deploying. Defaults to `development`.
NODE_ENV=production

# Public HTTPS origin of your storefront (required in production).
# Example: https://www.yourdomain.com
CLIENT_ORIGIN=https://your-domain.com

# Managed MySQL database (do NOT use XAMPP root MySQL for public hosting).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jewelry_store
# Dedicated least-privilege database user — never `root` in production.
DB_USER=jewelry_app
DB_PASSWORD=change_me

# Generate 32 random bytes and encode as Base64. Keep this outside source control.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=

# Persistent mounted volume path for uploads (products/, campaigns/ subfolders).
# Local ephemeral disk is not suitable for customer-facing product imagery.
UPLOADS_DIR=

# Set only to the actual number of trusted reverse proxies in front of the API.
TRUST_PROXY_HOPS=
